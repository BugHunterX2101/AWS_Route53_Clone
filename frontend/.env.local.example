# ──────────────────────────────────────────────────────────────────
# Frontend — Environment Variables
#
# For LOCAL development: copy this file to .env.local
# For VERCEL deployment: add these in the Vercel dashboard under
#   Project → Settings → Environment Variables
# ──────────────────────────────────────────────────────────────────

# URL of the FastAPI backend.
# On Vercel: set this to your Render backend URL:
#   https://route53-clone-backend.onrender.com
# Locally: leave as http://localhost:8000
BACKEND_URL=http://localhost:8000
