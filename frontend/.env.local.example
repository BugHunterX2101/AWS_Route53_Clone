# ──────────────────────────────────────────────
# Frontend — Local development environment
# Copy this file to .env.local and fill in values
# ──────────────────────────────────────────────

# Points the Next.js API proxy at the FastAPI backend.
# On Render this is injected automatically (see render.yaml).
# Locally, the default fallback inside next.config.js is used,
# so this variable is optional for local development.
BACKEND_URL=http://localhost:8000
