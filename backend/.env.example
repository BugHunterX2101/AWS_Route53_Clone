# ──────────────────────────────────────────────
# Backend — Environment Variables
# Copy this file to .env and fill in values
# ──────────────────────────────────────────────

# Generate a strong random key for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=supersecret-change-in-production-12345678901234567890

# Session lifetime in hours
SESSION_EXPIRE_HOURS=24

# SQLite (default) — use a full path for persistence on Render disk
DATABASE_URL=sqlite:///./route53_clone.db

# JSON array of allowed frontend origins
# Replace with your actual Render frontend URL after first deploy
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Set to true to allow ALL origins (useful for initial Render setup)
CORS_ALLOW_ALL=false
